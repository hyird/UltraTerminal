BasedOnStyle: LLVM
Standard: Latest
IndentWidth: 4
ColumnLimit: 0
UseTab: Never
BreakBeforeBraces: Attach
InsertBraces: true
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
PointerAlignment: Left
ReferenceAlignment: Left
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<windows\.h>'
    Priority: 2
  - Regex: '^<(boost/|google/|openssl/|wels/|ruvia/|pqxx/|spdlog/|d3d|dxgi|dwmapi\.h|dpapi\.h|bcrypt\.h|sddl\.h|aclapi\.h|credentialprovider\.h|ntsecapi\.h|wincred\.h|wtsapi32\.h|psapi\.h|wrl/)'
    Priority: 3
  - Regex: '^<'
    Priority: 1
  - Regex: '^"'
    Priority: 4
