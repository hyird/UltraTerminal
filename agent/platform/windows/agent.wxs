<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="Ultraterimal Windows Agent" Language="1033" Version="1.0.68" Manufacturer="Ultraterimal" UpgradeCode="B8EDB4D4-61A0-46D6-8FC2-493609A94AF7" InstallerVersion="500" Compressed="yes" Scope="perMachine">
        <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer Ultraterimal Agent is already installed." />
        <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
        <Feature Id="Agent" Title="Ultraterimal Agent" Level="1">
            <ComponentRef Id="AgentExecutable" />
            <ComponentRef Id="LoginProvider" />
            <ComponentRef Id="AgentData" />
            <?if $(var.IncludeIdd) = 1 ?>
            <ComponentRef Id="IddDriver" />
            <?endif ?>
        </Feature>
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="Ultraterimal">
                <Component Id="AgentExecutable" Guid="D2F2FCA5-0E75-49B0-ACB0-59B25836A6A0" Bitness="always64">
                    <File Id="AgentExe" Source="$(var.Payload)\agent.exe" KeyPath="yes" />
                    <ServiceInstall Id="AgentService" Name="UltraterimalAgent" DisplayName="Ultraterimal Agent" Description="Ultraterimal remote desktop Agent and authorized Windows login service." Type="ownProcess" Start="demand" ErrorControl="normal" Arguments="--service" />
                    <ServiceControl Id="AgentServiceControl" Name="UltraterimalAgent" Stop="both" Remove="uninstall" Wait="yes" />
                </Component>
                <Component Id="LoginProvider" Guid="1C895E30-E243-492A-AF4A-1F02859D7D49" Bitness="always64">
                    <File Id="LoginDll" Source="$(var.Payload)\ultraterimal_login.dll" KeyPath="yes" />
                    <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{1D064384-A0E1-4534-9216-96C19CDBBA3D}" Type="string" Value="Ultraterimal Windows Login" />
                    <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{1D064384-A0E1-4534-9216-96C19CDBBA3D}\InprocServer32" Type="string" Value="[#LoginDll]" />
                    <RegistryValue Root="HKLM" Key="SOFTWARE\Classes\CLSID\{1D064384-A0E1-4534-9216-96C19CDBBA3D}\InprocServer32" Name="ThreadingModel" Type="string" Value="Apartment" />
                    <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{1D064384-A0E1-4534-9216-96C19CDBBA3D}" Type="string" Value="Ultraterimal Windows Login" />
                </Component>
                <Component Id="AgentData" Guid="513913F5-EC5A-4501-894A-C119352631E5" Bitness="always64">
                    <File Id="CaBundle" Source="$(var.Payload)\ca.pem" KeyPath="yes" />
                    <File Id="InstallScript" Source="$(var.Payload)\install_agent.ps1" />
                    <File Id="GplLicense" Source="$(var.Payload)\COPYING" />
                    <File Id="AgentLicense" Source="$(var.Payload)\agent_license.md" />
                    <File Id="ThirdPartyNotices" Source="$(var.Payload)\third_party_notices.txt" />
                    <File Id="CorrespondingSource" Source="$(var.Payload)\source_info.txt" />
                </Component>
                <?if $(var.IncludeIdd) = 1 ?>
                <Directory Id="IDDFOLDER" Name="idd">
                    <Component Id="IddDriver" Guid="7C5A8E91-3D2B-4F18-9A6E-4D1B2C3E5F70" Bitness="always64">
                        <RemoveFile Id="ReplaceStaleIddFiles" Name="ultraterimal_idd.*" On="both" />
                        <File Id="IddDll" Source="$(var.Payload)\idd\ultraterimal_idd.dll" KeyPath="yes" />
                        <File Id="IddInf" Source="$(var.Payload)\idd\ultraterimal_idd.inf" />
                        <File Id="IddCat" Source="$(var.Payload)\idd\ultraterimal_idd.cat" />
                        <?if $(var.IncludeIddCert) = 1 ?>
                        <File Id="IddCer" Source="$(var.Payload)\idd\ultraterimal_idd.cer" />
                        <?endif ?>
                    </Component>
                </Directory>
                <?endif ?>
            </Directory>
        </StandardDirectory>
    </Package>
</Wix>
