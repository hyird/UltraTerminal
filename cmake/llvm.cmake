set(ULTRATERIMAL_MUSL_ROOT "$ENV{ULTRATERIMAL_MUSL_ROOT}" CACHE PATH "LLVM musl toolchain root")
if(NOT EXISTS "${ULTRATERIMAL_MUSL_ROOT}/bin/clang++")
    message(FATAL_ERROR "Set ULTRATERIMAL_MUSL_ROOT to the installed clang-cross toolchain")
endif()
set(CMAKE_C_COMPILER "${ULTRATERIMAL_MUSL_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${ULTRATERIMAL_MUSL_ROOT}/bin/clang++")
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-linux-musl)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-linux-musl)
set(CMAKE_SYSROOT "${ULTRATERIMAL_MUSL_ROOT}/x86_64-unknown-linux-musl/sysroot")
set(CMAKE_AR "${ULTRATERIMAL_MUSL_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${ULTRATERIMAL_MUSL_ROOT}/bin/llvm-ranlib")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -static")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")
