{
  "name": "ultraterimal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@heroui-pro/react",
    "heroui-pro",
    "@zowe/secrets-for-zowe-sdk"
  ],
  "scripts": {
    "protocol": "bun -e \"require('node:fs').mkdirSync('src/generated', {recursive:true})\" && pbjs -t static-module -w es6 -o src/generated/session.js ../protocol/schemas/session.proto && pbts -o src/generated/session.d.ts src/generated/session.js",
    "typecheck": "bun run protocol && tsc --noEmit",
    "build": "bun run typecheck && vite build",
    "test": "bun test ../tests/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.18.0",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@iconify-json/gravity-ui": "^1.2.0",
    "@iconify/react": "^6.0.0",
    "@react-aria/utils": ">=3.34.1",
    "motion": "^12.38.0",
    "protobufjs": "8.8.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-aria": ">=3.52.1",
    "react-aria-components": ">=1.21.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.0.0",
    "react-router": "7.18.4",
    "react-stately": ">=3.50.0",
    "recharts": "3.8.0",
    "tailwind-merge": ">=3.4.0",
    "tailwind-variants": ">=3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "3.9.8",
    "protobufjs-cli": "2.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  }
}
