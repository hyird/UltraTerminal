{
  "name": "ultraterimal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@heroui-pro/react",
    "heroui-pro",
    "@zowe/secrets-for-zowe-sdk"
  ],
  "scripts": {
    "protocol": "bun -e \"require('node:fs').mkdirSync('src/generated', {recursive:true})\" && pbjs -t static-module -w es6 -o src/generated/session.js ../protocol/schemas/session.proto && pbts -o src/generated/session.d.ts src/generated/session.js",
    "typecheck": "bun run protocol && tsc --noEmit",
    "build": "bun run typecheck && vite build",
    "test": "bun run protocol && bun test ../tests/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.23.1",
    "@heroui-pro/react": "1.0.0-beta.11",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@react-aria/utils": "^3.34.1",
    "motion": "^14.12.0",
    "protobufjs": "8.8.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.21.0",
    "react-router": "8.5.1",
    "react-stately": "^3.51.0",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "3.9.10",
    "protobufjs-cli": "2.7.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vite-plugin-singlefile": "2.3.4"
  }
}
